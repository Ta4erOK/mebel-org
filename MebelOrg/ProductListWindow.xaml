<Window x:Class="MebelOrg.ProductListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MebelOrg"
        Title="Список товаров — ООО «МебельОрг»"
        Height="800" Width="1200"
        MinHeight="620" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/icon.ico"
        Background="{StaticResource BrushMain}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Шапка: логотип, название, ФИО пользователя справа сверху, кнопка выхода -->
        <Border Grid.Row="0" Background="{StaticResource BrushSecondary}" Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0"
                       Source="Assets/icon.png"
                       Width="46" Height="46"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality" />

                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="ООО «МебельОрг»" FontSize="18" FontWeight="Bold" />
                    <TextBlock Text="Список товаров"
                               FontSize="12.5"
                               Foreground="{StaticResource BrushAccent}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="UserText"
                               FontSize="13.5"
                               VerticalAlignment="Center"
                               Margin="0,0,14,0" />
                    <Button x:Name="LogoutButton"
                            Content="Выход"
                            Style="{StaticResource SmallButton}"
                            Background="#FFFFFF"
                            Foreground="{StaticResource BrushAccent}"
                            BorderBrush="{StaticResource BrushAccent}"
                            Click="LogoutClick" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Панель поиска, фильтрации и сортировки: только менеджер и администратор -->
        <Border Grid.Row="1"
                x:Name="FilterPanel"
                Background="{StaticResource BrushSecondary}"
                BorderBrush="{StaticResource BrushAccent}"
                BorderThickness="0,2,0,0"
                Padding="18,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Поиск:"
                           FontSize="13"
                           VerticalAlignment="Center"
                           Margin="0,0,7,0" />
                <TextBox x:Name="SearchBox"
                         Width="250"
                         ToolTip="Поиск по всем текстовым полям. Несколько слов через пробел — все должны найтись."
                         TextChanged="SearchBoxTextChanged" />

                <TextBlock Text="Скидка:"
                           FontSize="13"
                           VerticalAlignment="Center"
                           Margin="18,0,7,0" />
                <ComboBox x:Name="DiscountBox"
                          Width="170"
                          SelectedIndex="0"
                          SelectionChanged="DiscountChanged">
                    <ComboBoxItem Content="Все диапазоны" />
                    <ComboBoxItem Content="от 0 до 10,99 %" />
                    <ComboBoxItem Content="от 11 до 14,99 %" />
                    <ComboBoxItem Content="15 % и более" />
                </ComboBox>

                <TextBlock Text="Сортировка:"
                           FontSize="13"
                           VerticalAlignment="Center"
                           Margin="18,0,7,0" />
                <ComboBox x:Name="SortBox"
                          Width="230"
                          SelectedIndex="0"
                          SelectionChanged="SortChanged">
                    <ComboBoxItem Content="По наименованию" />
                    <ComboBoxItem Content="Цена (по возрастанию)" />
                    <ComboBoxItem Content="Цена (по убыванию)" />
                    <ComboBoxItem Content="Количество (по возрастанию)" />
                    <ComboBoxItem Content="Количество (по убыванию)" />
                    <ComboBoxItem Content="Скидка (по убыванию)" />
                </ComboBox>

                <Button x:Name="ResetButton"
                        Content="Сбросить"
                        Style="{StaticResource SmallButton}"
                        Background="#FFFFFF"
                        Foreground="{StaticResource BrushAccent}"
                        BorderBrush="{StaticResource BrushAccent}"
                        Margin="18,0,0,0"
                        Click="ResetClick" />
            </StackPanel>
        </Border>

        <!-- Список товаров -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="16,12,16,4">
            <ItemsControl x:Name="ProductsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <local:SingleProductView />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Футер: количество позиций -->
        <Border Grid.Row="3"
                Background="#FFFFFF"
                BorderBrush="{StaticResource BrushCardBorder}"
                BorderThickness="0,1,0,0"
                Padding="18,8">
            <Grid>
                <TextBlock x:Name="PositionsText"
                           Text="Всего позиций: 0"
                           FontSize="12.5"
                           Foreground="{StaticResource BrushAccent}"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center" />
                <TextBlock Text="ООО «МебельОрг» · актуальные остатки на складе"
                           FontSize="11.5"
                           Foreground="{StaticResource BrushMuted}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
