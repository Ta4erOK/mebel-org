<UserControl x:Class="MebelOrg.SingleProductView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <!-- Фон строки: белый, #008080 при скидке больше 15%, серый при отсутствии на складе -->
    <Border Background="{Binding RowBackground}"
            BorderBrush="#B7E6E6"
            BorderThickness="1"
            CornerRadius="5"
            Margin="0,0,0,8"
            Padding="0">
        <Grid Margin="12,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="132" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="190" />
            </Grid.ColumnDefinitions>

            <!-- Зона 1. Фотография товара или заглушка picture.png -->
            <Border Grid.Column="0"
                    Width="120" Height="120"
                    Background="#FFFFFF"
                    BorderBrush="#D8F0F0"
                    BorderThickness="1"
                    CornerRadius="4"
                    VerticalAlignment="Top">
                <Image Source="{Binding Photo}"
                       Stretch="Uniform"
                       Margin="4"
                       RenderOptions.BitmapScalingMode="HighQuality" />
            </Border>

            <!-- Зона 2. Текстовые характеристики и цена -->
            <Grid Grid.Column="1" Margin="10,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="{Binding Title}"
                               FontSize="16"
                               FontWeight="Bold"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{Binding PrimaryBrush}" />
                    <TextBlock Text="{Binding ArticleLine}"
                               FontSize="12"
                               Margin="0,3,0,0"
                               Foreground="{Binding SecondaryBrush}" />
                    <TextBlock Text="{Binding CategoryLine}"
                               FontSize="12"
                               Margin="0,1,0,0"
                               Foreground="{Binding SecondaryBrush}" />
                    <TextBlock Text="{Binding Description}"
                               FontSize="12"
                               MaxHeight="34"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0"
                               Foreground="{Binding SecondaryBrush}" />
                    <TextBlock Text="{Binding ManufacturerLine}"
                               FontSize="12"
                               Margin="0,4,0,0"
                               Foreground="{Binding SecondaryBrush}" />
                    <TextBlock Text="{Binding SupplierLine}"
                               FontSize="12"
                               Margin="0,1,0,0"
                               Foreground="{Binding SecondaryBrush}" />
                    <TextBlock Text="{Binding UnitLine}"
                               FontSize="12"
                               Margin="0,1,0,0"
                               Foreground="{Binding SecondaryBrush}" />
                </StackPanel>

                <!-- Цена: старая перечёркнута красным, итоговая — чёрным (белым на тёмной строке) -->
                <Grid Grid.Row="1" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding OldPriceText}"
                               Visibility="{Binding OldPriceVisibility}"
                               FontSize="13"
                               TextDecorations="Strikethrough"
                               VerticalAlignment="Center"
                               Foreground="{Binding OldPriceBrush}"
                               Margin="0,0,10,0" />

                    <TextBlock Grid.Column="1"
                               Text="{Binding FinalPriceText}"
                               FontSize="20"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Foreground="{Binding PrimaryBrush}" />

                    <TextBlock Grid.Column="3"
                               Text="{Binding StockText}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Foreground="{Binding SecondaryBrush}" />
                </Grid>
            </Grid>

            <!-- Зона 3. Блок действующей скидки -->
            <Border Grid.Column="2"
                    BorderBrush="{Binding SecondaryBrush}"
                    BorderThickness="1,0,0,0"
                    Padding="14,0,0,0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Скидка"
                               FontSize="11.5"
                               HorizontalAlignment="Center"
                               Foreground="{Binding SecondaryBrush}" />
                    <TextBlock Text="{Binding DiscountValueText}"
                               FontSize="26"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Foreground="{Binding PrimaryBrush}" />
                    <TextBlock Text="{Binding DiscountHintText}"
                               FontSize="11"
                               HorizontalAlignment="Center"
                               Foreground="{Binding SecondaryBrush}" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
